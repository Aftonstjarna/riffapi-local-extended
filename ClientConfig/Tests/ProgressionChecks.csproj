<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net45</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SmokeTest Condition="'$(SmokeTest)' == ''">ProgressionStore</SmokeTest>
    <AssemblyName>$(SmokeTest)Smoke</AssemblyName>
    <BaseIntermediateOutputPath>obj/$(SmokeTest)/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SmokeTest)Smoke.cs" />
    <Compile Include="../ProgressionStore.cs" Condition="'$(SmokeTest)' != 'ProgressionRewards'" />
    <Compile Include="../ProgressionCheckpoints.cs" Condition="'$(SmokeTest)' == 'ProgressionCheckpoints' Or '$(SmokeTest)' == 'PrestigeTransaction'" />
    <Compile Include="../ProgressionRewards.cs" Condition="'$(SmokeTest)' == 'ProgressionRewards'" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net45" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="ValidateSmokeTest" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(SmokeTest)' != 'ProgressionStore' And '$(SmokeTest)' != 'ProgressionCheckpoints' And '$(SmokeTest)' != 'PrestigeTransaction' And '$(SmokeTest)' != 'ProgressionRewards'" Text="Unsupported progression smoke test" />
  </Target>
</Project>
